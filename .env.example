# =============================================================
# Konfiguracja środowiskowa panelu — skopiuj do `.env` i uzupełnij.
#   cp .env.example .env && chmod 640 .env && chown root:mailweb .env
#   (grupa = użytkownik, jako który PHP-FPM wykonuje Roundcube i panel: mailweb przy osobnej puli z install.sh
#    sekcja 1b; www-data tylko, gdy Roundcube dzieli pulę [www] z innymi stronami)
# Najlepiej poza katalogiem aplikacji (1.1.0):  /etc/mailpanel/panel.env  (root:mailweb 640, katalog
#   /etc/mailpanel root:mailweb 750) — jeśli istnieje, jest czytany PRZED <katalog>/.env.
# Plik NIE może trafić do repozytorium ani być serwowany przez WWW (blokuje go .htaccess — zweryfikuj
# po instalacji: /.env musi dać 403 — ale to jedyna zapora, gdy AllowOverride zniknie; dlatego /etc/mailpanel).
# =============================================================

# prod = realne logowanie IMAP + integracje systemowe (Fail2Ban/Postfix)
# dev  = mock IMAP (weryfikacja po hashu z bazy), integracje wyłączone
APP_ENV=prod

APP_TIMEZONE=Europe/Warsaw

# Baza panelu (schemat `mailserver`).
# Konto DB `mailpanel` dostaje uprawnienia per tabela z sql/panel_grants.sql (nie `mailserver.*`).
# Hasło: tylko znaki [A-Za-z0-9._~+-] (openssl rand -hex 24) — install.sh odrzuca inne, bo wstawia je do konfiguracji.
PANEL_DB_DSN="mysql:host=127.0.0.1;dbname=mailserver;charset=utf8mb4"
PANEL_DB_USER=mailpanel
PANEL_DB_PASS=TU_WSTAW_SILNE_HASLO

# Ścieżka do konfiguracji Fail2Ban (odczyt dla zakładki panelu). Plik należy do roota (root:root 644),
# a zapis robi helper /usr/local/sbin/mailpanel-f2b-apply, który obsługuje WYŁĄCZNIE
# /etc/fail2ban/jail.local — nie zmieniaj tej wartości.
F2B_JAIL_LOCAL=/etc/fail2ban/jail.local

# Adresy, które NIE podlegają limitom logowania/rejestracji w portalu i które skaner podejrzanych IP pomija
# (a panel nie pozwala ich zbanować). Adresy i zakresy CIDR po przecinku, np. "203.0.113.7,2001:db8:1::/48" —
# wpisz IP serwera i swoje stałe IP administratora.
SCAN_TRUSTED_IPS=

# Języki dodane w panelu (kopia / wgrany pakiet, 1.3.0): pliki JSON w katalogu DANYCH, do którego pisze tylko użytkownik
# puli PHP (mailweb, 0750; tworzy go install.sh, sekcja 12). Polski i angielski są w kodzie i działają bez niego.
# LANG_DATA_DIR=/var/lib/roundcontrol/lang
