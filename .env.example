# =============================================================
# Konfiguracja środowiskowa panelu — skopiuj do `.env` i uzupełnij.
#   cp .env.example .env && chmod 640 .env && chown root:www-data .env
# Plik .env NIE może trafić do repozytorium ani być serwowany przez WWW
# (blokuje go .htaccess — zweryfikuj po instalacji: /.env musi dać 403).
# =============================================================

# prod = realne logowanie IMAP + integracje systemowe (Fail2Ban/Postfix)
# dev  = mock IMAP (weryfikacja po hashu z bazy), integracje wyłączone
APP_ENV=prod

APP_TIMEZONE=Europe/Warsaw

# Baza panelu (schemat `mailserver`).
# Użytkownik DB potrzebuje: SELECT, INSERT, UPDATE, DELETE, EXECUTE.
PANEL_DB_DSN="mysql:host=127.0.0.1;dbname=mailserver;charset=utf8mb4"
PANEL_DB_USER=mailpanel
PANEL_DB_PASS=TU_WSTAW_SILNE_HASLO

# Ścieżka do konfiguracji Fail2Ban (edycja z zakładki panelu)
F2B_JAIL_LOCAL=/etc/fail2ban/jail.local

# IP pomijane przez skaner podejrzanych IP (localhost jest zawsze dodany).
# Rozdziel przecinkami — wpisz IP serwera i swoje stałe IP administratora,
# żeby skaner ich nie flagował ani nie pozwalał zbanować.
SCAN_TRUSTED_IPS=
