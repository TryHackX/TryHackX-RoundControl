# /etc/systemd/system/mailpanel-purge-deleted.timer   (install.sh section 11)
# Daily; Persistent=true runs a missed run after boot. The server has no cron - systemd timers only.
[Unit]
Description=RoundControl: daily purge of quarantined mailboxes

[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
