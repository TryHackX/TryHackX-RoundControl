# =====================================================================
# Jaile panelu Roundcube — instalowane przez install.sh do
# /etc/fail2ban/jail.d/mailpanel.local (Fail2Ban czyta jail.d/*.local
# automatycznie; plik można bezpiecznie nadpisywać = idempotencja).
#
# Panel edytuje z zakładki „Fail2Ban" plik jail.local: [DEFAULT] + jaile
# roundcube-auth, dovecot, postfix-sasl, recidive. Poniższe DWA jaile
# obsługują ręczne blokady z panelu (stałe i czasowe) — bez nich przyciski
# „Permaban"/bany ze skanera nie mają gdzie trafić.
#
# Wymagane puste logi (tworzy install.sh):
#   touch /var/log/mailpanel-permaban.log /var/log/mailpanel-tempban.log
# =====================================================================

# Blokady STAŁE z panelu (ręczny permaban)
[panel-permaban]
enabled = true
filter = panel-permaban
backend = polling
logpath = /var/log/mailpanel-permaban.log
banaction = nftables-allports
bantime = -1
bantime.increment = false
findtime = 1d
maxretry = 1000000

# Blokady CZASOWE z panelu (skaner: ban 1h..3 miesiące)
# (1.3.3) The panel sets bantime right before every banip, but after a Fail2Ban restart (package upgrade, reboot) the
# jail restores only the bans younger than the bantime written HERE, capped to it. So this is the longest ban the panel
# hands out (90 days); with 24h (up to 1.3.2) a 30-day ban vanished on the first restart.
[panel-tempban]
enabled = true
filter = panel-tempban
backend = polling
logpath = /var/log/mailpanel-tempban.log
banaction = nftables-allports
bantime = 90d
bantime.increment = false
findtime = 1d
maxretry = 1000000

# (1.1.0) Failed portal logins (webmail + admin panel) -> firewall ban, instead of the old sleep() in PHP.
# DISABLED by default: enable (enabled = true, then fail2ban-client reload) once you have checked with
#   journalctl -t mailpanel -n 5   (after one wrong password at the portal)
# that the lines "auth-failure ip=... kind=... user=..." arrive. Keep your own address in ignoreip.
[mailpanel-portal]
enabled = false
filter = mailpanel-portal
backend = systemd
maxretry = 10
findtime = 10m
bantime = 1h
banaction = nftables-multiport
port = http,https
