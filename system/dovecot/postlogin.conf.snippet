# =====================================================================
# Dovecot 2.4 (Debian 13) — post-login services that record IMAP/POP3
# logins in the panel's database (CALL sp_register_login through
# /usr/local/bin/dovecot-postlogin.sh; credentials in
# /etc/dovecot/mysql-mailpanel.cnf — install.sh section 6).
# Local connections (Roundcube/webmail) are skipped by the script itself.
#
# install.sh section 6 installs this file as
#   /etc/dovecot/conf.d/99-roundcontrol-postlogin.conf
# (checked with doveconf -n, removed again on any error). By hand: copy it
# there, or paste it into /etc/dovecot/dovecot.conf when that file does not
# include conf.d/*.conf; then doveconf -n && systemctl reload dovecot.
# Every IMAP/POP3 session starts through the script: if it cannot run,
# nobody can log in over IMAP/POP3 — test a login right after the reload.
# The listeners belong to vmail, the user that runs imap/pop3.
# (Verified on Dovecot 2.4.1, 2026-07-12.)
# =====================================================================

service imap-postlogin {
  executable = script-login /usr/local/bin/dovecot-postlogin.sh
  unix_listener imap-postlogin {
    mode = 0600
    user = vmail
  }
  user = dovecot
}
service imap {
  executable = imap imap-postlogin
}

service pop3-postlogin {
  executable = script-login /usr/local/bin/dovecot-postlogin.sh
  unix_listener pop3-postlogin {
    mode = 0600
    user = vmail
  }
  user = dovecot
}
service pop3 {
  executable = pop3 pop3-postlogin
}
