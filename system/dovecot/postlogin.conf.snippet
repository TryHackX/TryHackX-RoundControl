# =====================================================================
# Dovecot 2.4 (Debian 13) — post-login services that record IMAP/POP3
# sign-ins in the panel's database (CALL sp_register_login through
# /usr/local/bin/dovecot-postlogin.sh; credentials in
# /etc/dovecot/mysql-mailpanel.cnf — install.sh section 6).
# Local connections (Roundcube / webmail) are skipped by the script itself.
#
# Paste into /etc/dovecot/dovecot.conf (checked on 2.4.1, 2026-07-12).
# =====================================================================

service imap-postlogin {
  executable = script-login /usr/local/bin/dovecot-postlogin.sh
  unix_listener imap-postlogin {
    mode = 0600
    user = vmail
  }
  user = dovecot
}
service imap {
  executable = imap imap-postlogin
}

service pop3-postlogin {
  executable = script-login /usr/local/bin/dovecot-postlogin.sh
  unix_listener pop3-postlogin {
    mode = 0600
    user = vmail
  }
  user = dovecot
}
service pop3 {
  executable = pop3 pop3-postlogin
}
