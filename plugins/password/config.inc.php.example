<?php
/**
 * Configuration of Roundcube's `password` plugin — users change their mailbox password themselves
 * (Settings → Password).
 *
 * The SQL driver writes a $6$ hash (SHA512-CRYPT) into mailserver.virtual_users, matching Dovecot's
 * `default_pass_scheme = SHA512-CRYPT`. It connects as the dedicated database user `roundcubepw`, which has ONLY
 * SELECT/UPDATE on virtual_users (least privilege).
 *
 * This file goes to /var/www/roundcube/plugins/password/config.inc.php (outside the public_html web root),
 * chmod 640, root:<the panel's PHP pool user> (mailweb). install.sh section 5 replaces SILNE_HASLO_POLICY with a
 * generated password (openssl rand -hex 24) and keeps it on later runs.
 */
$config['password_driver'] = 'sql';
$config['password_confirm_current'] = true;        // ask for the current password
$config['password_minimum_length'] = 10;           // the same as the panel's pwd_min_length
$config['password_require_nonalpha'] = true;       // at least one digit / special character
$config['password_force_save'] = true;
$config['password_algorithm'] = 'sha512-crypt';
$config['password_algorithm_prefix'] = '';         // Dovecot keeps $6$ without the {SHA512-CRYPT} prefix
$config['password_db_dsn'] = 'mysql://roundcubepw:SILNE_HASLO_POLICY@localhost/mailserver';
$config['password_query'] = 'UPDATE virtual_users SET password=%P WHERE email=%u';
